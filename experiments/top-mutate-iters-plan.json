{
    "experiment_name": "topology-mutation-iters",

    "additional_controls":{
        "total_offspring": 1000000,
        "stop_condition": "fwds",
        "stop_condition_value": 100000,
        "sgd_early_stop": 1000,
        "batch_size": 5,
        "initial_batch_size": 5,
        "single_structural_mutation": false,
        "n_fourier_features": 16,
        "num_inputs": 19,
        "objective_functions": [
            "psnr",
            "mse",
            "lpips",
            "dists",
            "ssim",
            "haarpsi",
            "vif",
            "msssim",
            "dss",
            "gmsd"
        ],
        "init_connection_probability": 0.5,
        "init_connection_probability_fourier": 0.50,
        "prob_add_node": 0.85,
        "prob_add_connection": 0.85,
        "prob_remove_node": 0.15,
        "prob_disable_connection": 0.15,
        "sgd_l2_reg": 0.0003,
        "hidden_nodes_at_start": [16],
        "node_activation_prune_threshold": 0.01,
        "prune_threshold": 0.0001,
        "target_resize": [64,64],
        "sgd_steps": 100
    },

    "targets":[
        "data/skull.png",
        "data/sunrise.png",
        "data/dolphin.png",
        "data/apple.png"
    ],

    "color_modes":
    [
        "L",
        "HSL",
        "HSL",
        "HSL"
    ],

    "mode": "grid",

    "variables":[
       "topology_mutation_iters"
    ],


    "levels":[
        [0, 1, 4, 16]
    ],

    "additional_parameters": {

        "topology_mutation_iters": {
            "min_pruned":{
                "0" : 0,
                "1" : 0,
                "4" : 2,
                "16" : 10
            }
        }
    },

    "name_template": "{topology_mutation_iters:03d}_iters"

}