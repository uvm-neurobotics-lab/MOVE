{
    "experiment_name": "n-ffts-long",

    "additional_controls":{
        "stop_condition": "fwds",
        "stop_condition_value": 2500000,
        "hidden_nodes_at_start": 0,
        "connection_prune_threshold": 0.001,
        "connection_bloat": 3,
        "bloat_prune_ratio": 0.00,
        "batch_size": 100,
        "initial_batch_size": 100,
        "num_cells":  100,
        "max_weight":10.0,
        "soft_mask_sigma": 0.5,
