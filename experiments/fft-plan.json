        "sgd_early_stop": 20,
        "sgd_steps":2000
    },

    "targets":[
        "data/skull.png",
        "data/sunrise.png",
        "data/dolphin.png",
        "data/apple.png",
        "data/butterfly.png"  
    ],

    "color_modes":
    [
        "L",
        "HSL",
        "HSL",
        "HSL",
        "HSL"
    ],

    "mode": "grid",

    "variables":[
       "n_fourier_features"
    ],


    "levels":[
        [0, 
        16]
    ],

    "additional_parameters": {
    },

    "name_template": "{n_fourier_features:03d}_ffts"

}