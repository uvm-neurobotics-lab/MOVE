{
    "experiment_name": "telo-25-topology-iters",

    "additional_controls":{
        "num_generations": 2000,
        "num_cells": 50,
        "target_resize": [128, 128],
        "hidden_nodes_at_start": 0,
        "sgd_learning_rate": 0.01,
        "sgd_early_stop": 1000000,
        "connection_prune_threshold": 0.001,
        "extra_bloat": 3,
        "bloat_prune_rate": 0.01,
        "max_weight": 10.0,
        "init_connection_probability": 0.01,
        "stop_condition": "passes",
        "stop_condition_value": 1000000,
        "total_offspring": 10000000,
        "batch_size": 50,
        "initial_batch_size": 50,
        "max_nodes": 100,
        "max_connections": 300,
        "checkpoint_frequency": 5
        
        
    },

    "targets":[
        "data/skull.png",
        "data/apple.png",
        "data/dolphin.png",
        "data/sunrise.png",
        "data/butterfly.png",
        "data/spiral.png",
        "data/checkers.png",
        "data/fly.png",
        "data/maze.png",
        "data/linear_sin.png"
    ],

    "color_modes":
    [
        "L",
        "HSL",
        "HSL",
        "HSL",
        "HSL",
        "L",
        "L",
        "HSL",
        "L",
        "L"
    ],

    "mode": "grid",

    "variables":[
       "topology_mutation_iters",
       "sgd_steps"
    ],


    "levels":[
        [0, 4, 16, 32],
        [0, 100]
    ],

    "additional_parameters": {
        "sgd_steps": {
            "prob_mutate_weight":{
                "0" : 0.35,
                "100" : 0
            },
            "weight_mutation_std":{
                "0" : 1.0,
                "100" : 0
            }
        }
    },

    "name_template": "{topology_mutation_iters:03d}_mutations_{sgd_steps:03d}_steps"

}
