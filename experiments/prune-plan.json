{
    "experiment_name": "pruning",

    "additional_controls":{
        "total_offspring": 1000000,
        "stop_condition": "fwds",
        "stop_condition_value": 100000,
        "sgd_early_stop": 10,
        "batch_size": 16,
        "initial_batch_size": 16,
        "single_structural_mutation": false,
        "objective_functions": [
            "psnr",
            "mse",
            "lpips",
            "dists",
            "ssim",
            "haarpsi",
            "vif",
            "msssim",
            "dss",
            "gmsd"
        ],
        "init_connection_probability": 0.5,
        "init_connection_probability_fourier": 0.50,
        "prob_add_node": 0.85,
        "prob_add_connection": 0.85,
        "prob_remove_node": 0.15,
        "prob_disable_connection": 0.15,
        "sgd_l2_reg": 0.0003,
        "hidden_nodes_at_start": [16],
        "topology_mutation_iters": 2,
        "sgd_steps" : 1000

    },

    "targets":[
        "data/skull.png",
        "data/sunrise.png",
        "data/dolphin.png",
        "data/apple.png"
    ],

    "color_modes":
    [
        "L",
        "HSL",
        "HSL",
        "HSL"
    ],

    "mode": "grid",

    "variables":[
       "min_pruned"
    ],


    "levels":[
        [0, 
        1]
    ],

    "additional_parameters": {
        "min_pruned": {
            "sgd_l2_reg":{
                "0": 0, 
                "1": 0.0003
            },
            "prune_threshold":{
                "0": 0, 
                "1": 0.0001
            }

        }
    },

    "name_template": "{min_pruned:03d}_min_pruned"

}