{
    "experiment_name": "clip-prompts",

    "additional_controls":{
        "alg": "move",
        "output_dir": "../results/clip",
        "clip_disable_partials": true,
        "clip_num_variants": 1,
        "use_fused_optimizer": true,
        "use_radial_distance":true,
        "do_crossover":false,
        "coord_range": [-1.0,1.0],
        "clip_random_seed": 7,
        "clip_microbatch_size": 16,
        "hidden_nodes_at_start": 2,
        "num_cells": 84,
        "initial_batch_size": 84,
        "batch_size": 84,
        "allow_jumps": 16,
        "soft_mask_sigma": 0.0,
        "soft_mask_mu": 0.0,
        "soft_mask_min": 0.0,
        "move_fns_per_cell": 3,
        "max_weight": 20.0,
        "sgd_clamp_grad": 0.5,
        "stop_condition": "passes",
        "stop_condition_value": 2560000,
        "sgd_early_stop": 10,
        "grad_every": 1,
        "sgd_steps": 1000,
        "n_fourier_features": 16,
        "fourier_feature_scale": 1.0,
        "use_fourier_features": true,
        "weight_init_std": 1.0,
        "sgd_learning_rate": 0.01,
        "color_mode": "HSL",
        "res_h": 224,
        "res_w": 224,
        "checkpoint_frequency": 1

    },

    "targets":[
        ["a smiley face", "a smile", "an emoji", "an emoji with a smile", "a happy face", "a happy face emoji", "a yellow happy face emoji", "a yellow happy face", "yellow circle"]
    ],

    "color_modes":
    [
        "RGB"
    ],

    "mode": "grid",

    "variables":[
       "sgd_learning_rate"
    ],


    "levels":[
        [0.1, 0.01, 0.001, 0.0001]
    ],

    "name_template": "clip_{sgd_learning_rate:0.4f}_lr"

}