{
  "name": "clip",
  "controls": {
    "alg": "move",
    "output_dir": "tmp_results/clip",
    "target-prompts": ["a smiley face", "a smile", "an emoji", "an emoji with a smile", "a happy face", "a happy face emoji", "a yellow happy face emoji", "a yellow happy face", "yellow circle"],
    "target": ["flat yellow smiley face emoji, centered, simple vector icon, clean outline, no text, white background"],
    "clip_disable_partials": true,
    "use_fused_optimizer": true,
    "use_radial_distance":true,
    "do_crossover":false,
    "coord_range": [-0.5,0.5],
    "clip_random_seed": 7,
    "hidden_nodes_at_start": 2,
    "clip_microbatch_size": 4,
    "clip_embed_microbatch_size": 4,
    "num_cells": 60,
    "initial_batch_size": 60,
    "batch_size": 60,
    "offspring_per_cell": 1,
    "allow_jumps": 16,
    "soft_mask_sigma": 0.0,
    "soft_mask_mu": 0.0,
    "soft_mask_min": 0.0,
    "move_fns_per_cell": 3,
    "max_weight": 20.0,
    "stop_condition": "passes",
    "stop_condition_value": 2560000,
    "sgd_early_stop": 20,
    "grad_every": 1,
    "sgd_steps": 1000,
    "n_fourier_features": 8,
    
    "init_connection_probability": 0.1,
    "init_connection_probability_fourier": 0.1,
    "force_init_path_inputs_outputs": true,

    "connection_bloat": 1,
    "initial_mutations":0,
    "fourier_feature_scale": 1.0,
    "use_fourier_features": true,
    "weight_init_std": 1.0,
    "sgd_learning_rate": 0.01,
    "color_mode": "HSL",
    "res_h": 33,
    "res_w": 33,
    "checkpoint_frequency": 10
},
"conditions": [
    {
        "clip": {
            "clip_num_variants": 10,
            
            "clip_noise_scale": 0.1,
            "clip_noise_anneal": false,
            "clip_noise_final_scale": 0.0,
            "clip_noise_anneal_start": 0.0,
            "clip_noise_anneal_end": 0.1,
            "clip_noise_anneal_power": 1.0,
            
        "clip_augmentations": 4,
        "clip_aug_min_scale": 0.45,
        "clip_aug_max_scale": 1.0,
        "clip_aug_flip_prob": 0.5,
        "clip_aug_jitter_std": 0.02
      }
    }
  ]
}
