{
  "name": "clip-partials",
  "controls": {
    "alg": "move",
    "output_dir": "tmp_results/clip_partials",
    "target": "the blue bird is on a branch of a tree. a small blue bird is perched on a small limb. the bird is on the branch with leaves alone. a bird is perched on top of a branch with many leaves. a bird perched on top of a leaf filled tree.",

    "use_fused_optimizer": true,
    "use_radial_distance": true,
    "do_crossover": false,
    "coord_range": [-1.0, 1.0],

    "clip_random_seed": 7,
    "clip_microbatch_size": 16,
    "clip_num_variants": 1,
    "clip_noise_scale": 0.0,

    "clip_include_partials": true,
    "clip_disable_partials": false,
    "clip_partial_min_length": 1,
    "clip_partials_n_tokens": 1,
    "clip_max_partial_prompts": -1,

    "move_fns_per_cell": 3,
    "num_cells": 128,
    "initial_batch_size": 128,
    "batch_size": 128,
    "allow_jumps": 1,

    "hidden_nodes_at_start": 32,
    "weight_init_std": 1.0,
    "max_weight": 20.0,

    "sgd_clamp_grad": 0.5,
    "stop_condition": "passes",
    "stop_condition_value": 640000,
    "sgd_early_stop": 20,
    "grad_every": 1,
    "sgd_steps": 1000,
    
    "save_map_images_every": 5,

    "n_fourier_features": 8,
    "fourier_feature_scale": 1.0,
    "use_fourier_features": true,

    "sgd_learning_rate": 0.03,
    "color_mode": "RGB",
    "res_h": 128,
    "res_w": 128
  },
  "conditions": [
    {
      "clip-partials-token-bins": {
        "clip_augmentations": 0,
        "clip_aug_min_scale": 0.45,
        "clip_aug_max_scale": 1.0,
        "clip_aug_flip_prob": 0.5,
        "clip_aug_jitter_std": 0.02
      }
    }
  ]
}
